# Exemplo de ativação do fallback gratuito. Não coloque chaves reais neste arquivo.
# Copie os nomes para o ambiente seguro do processo. Sem chave, o serviço continua só no MiniMax.
# Este arquivo não publica nem reinicia a VPS.

OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat:free,qwen/qwen3-coder:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FALLBACK_ENABLED=
# Tempo máximo até os headers de cada provedor, em milissegundos. Não corta um stream já iniciado.
ATTEMPT_MS=90000
# Teto de todas as tentativas de resumo somadas. Estourou, o restante segue por excerto, sem Gemini.
COMPACTION_BUDGET_MS=60000
# false desliga só a compactação. O repasse de 400/413 e o fallback continuam.
COMPACTION_ENABLED=

# Conta existente Strata: application OAuth confidencial com PKCE S256 e callback fixo registrado.
# Nenhum segredo real pertence a este exemplo. Sem configuração completa a integração fica desativada.
STRATA_MCP_RESOURCE_URL=
STRATA_OAUTH_ISSUER=
STRATA_OAUTH_CLIENT_ID=
STRATA_OAUTH_CLIENT_SECRET=
STRATA_OAUTH_REDIRECT_URI=
# Chave própria de 32 bytes, codificada em hexadecimal (64 caracteres) ou base64.
STRATA_TOKEN_ENCRYPTION_KEY=
# Os escopos devem estar registrados/atribuídos ao client OAuth no ERP/issuer.
STRATA_OAUTH_SCOPES=mcp:identidade
# After enabling the ERP query catalog and renewing user consent:
# STRATA_OAUTH_SCOPES=mcp:identidade mcp:erp:ler mcp:conhecimento offline_access
