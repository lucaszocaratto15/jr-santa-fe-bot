# Exemplo de ativação do fallback gratuito. Não coloque chaves reais neste arquivo.
# Copie os nomes para o ambiente seguro do processo. Sem chave, o serviço continua só no MiniMax.
# Este arquivo não publica nem reinicia a VPS.

OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat:free,qwen/qwen3-coder:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FALLBACK_ENABLED=
# Tempo máximo até os headers de cada provedor, em milissegundos. Não corta um stream já iniciado.
ATTEMPT_MS=90000
# Teto de todas as tentativas de resumo somadas. Estourou, o restante segue por excerto, sem Gemini.
COMPACTION_BUDGET_MS=60000
# false desliga só a compactação. O repasse de 400/413 e o fallback continuam.
COMPACTION_ENABLED=
